# Configuración de base de datos PostgreSQL
DB_HOST=localhost
DB_NAME=ledgerx
DB_USER=ledgerx_user
DB_PASSWORD=ledgerx_pass

# Configuración de MongoDB
MONGO_HOST=localhost
MONGO_DB=ledgerx_audit

# Seguridad JWT
JWT_SECRET=cambia_esta_clave_por_una_segura_de_al_menos_256_bits

# Usuario administrador inicial (creado automáticamente al levantar la app)
ADMIN_EMAIL=admin@ledgerx.com
ADMIN_PASSWORD=123456
